<?xml version="1.0" encoding="utf-8"?>
<!--
  Franka Emika Panda (7-DOF arm + Panda hand) matching robosuite v1.4.0
  (`robots/panda/robot.xml` + `grippers/panda_gripper.xml`), the exact
  simulator model used by LIBERO. Visual meshes: Apache 2.0 (franka_description v0.7.0).
-->
<robot name="panda">
  <link name="panda_link0">
    <visual>
      <geometry>
        <mesh filename="meshes/link0_vis.stl"/>
      </geometry>
    </visual>
  </link>

  <link name="panda_link1">
    <visual>
      <geometry>
        <mesh filename="meshes/link1_vis.stl"/>
      </geometry>
    </visual>
  </link>
  <joint name="panda_joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.333"/>
    <parent link="panda_link0"/>
    <child link="panda_link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750"/>
  </joint>

  <link name="panda_link2">
    <visual>
      <geometry>
        <mesh filename="meshes/link2_vis.stl"/>
      </geometry>
    </visual>
  </link>
