    <parent link="panda_link8"/>
    <child link="panda_hand"/>
  </joint>

  <link name="panda_eef"/>
  <joint name="panda_eef_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.097"/>
