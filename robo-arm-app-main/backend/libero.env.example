# LIBERO free-prompt demo: X-VLA on the VENTUNO Q board through the demo bridge (demo_bridge/).
# Copy to .env (or export these). Start the bridge first, on port 8002 (demo_bridge/README.md).
SO101_SIM_LINK=libero
SO101_BOARD_LINK=libero
SO101_LIBERO_URL=http://127.0.0.1:8002
SO101_PROTOCOL_FILE=config/protocol.libero.json
SO101_PROFILES_FILE=config/profiles.libero.json
# Separate database: the SO-101 profiles and runs stay in ./data.
SO101_DATA_DIR=./data-libero
# The bridge stalls for 1-3 s while it resets the scene after a run (measured 26 Nov; the reset
# holds Python's lock). Tolerate that: the SO-101 defaults (2 s offline, 1.5 s stale) would end
# a run started during the reset as sim_offline or telemetry_stale.
SO101_SIM_TIMEOUT_MS=8000
SO101_TELEMETRY_STALE_MS=6000
# A bridge start can take a few seconds when the board check is not cached.
SO101_BOARD_TIMEOUT_MS=8000
# Longest LIBERO episode at the 400-step cap is about 2 min; leave room for the start.
SO101_RUN_WALL_TIMEOUT_S=300
SO101_MODE=dev
SO101_EVIDENCE_CLASS=laptop
SO101_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SO101_CAMERA_PREVIEW=true
SO101_CAMERA_FPS=10
